APP_ENV=local
APP_NAME=Inventory Manager
APP_URL=http://localhost:8090
# Set true only when recipients can reach an intentionally configured internal URL.
APP_URL_ACCESSIBLE_INTERNAL=false
APP_PORT=8090
SESSION_IDLE_TIMEOUT=1800
APP_IMAGE=inventory-manager
IMAGE_TAG=local

DB_HOST=db
DB_PORT=3306
DB_NAME=inventory_manager
DB_USER=inventory_app
DB_PASSWORD=change-this-app-password
MYSQL_ROOT_PASSWORD=change-this-root-password

# Weekly pending-order reminders (authenticated SMTP with verified STARTTLS)
ADMIN_EMAILS=admin@example.com,inventory@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM=inventory@example.com

# Keep the existing Credential Manager key unchanged for compatibility.
CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_EXISTING_BASE64_32_BYTE_KEY
AWS_REGION=
AWS_S3_BUCKET=
AWS_S3_PREFIX=
